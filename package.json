{
  "name": "agy-online",
  "version": "3.0.17",
  "description": "AGY Online — Autonomous Terminal & Development Workspace for Google Antigravity CLI (agy)",
  "license": "MIT",
  "bin": {
    "agy-online": "bin/agy-online.mjs",
    "ai-cli-online": "bin/agy-online.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huacheng/agy-online.git"
  },
  "homepage": "https://github.com/huacheng/agy-online#readme",
  "bugs": {
    "url": "https://github.com/huacheng/agy-online/issues"
  },
  "keywords": [
    "terminal",
    "web-terminal",
    "xterm",
    "tmux",
    "antigravity",
    "antigravity-cli",
    "agy",
    "google-antigravity",
    "cli"
  ],
  "files": [
    "bin/",
    "shared/dist/",
    "shared/package.json",
    "web/dist/",
    "web/package.json",
    "start.sh",
    "install-service.sh"
  ],
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=shared && npm run build --workspace=web && go build -o bin/agy-online ./cmd/agy-online",
    "build:go": "go build -o bin/agy-online ./cmd/agy-online",
    "start": "./bin/agy-online start",
    "test": "npm run test --workspace=web && go test -v ./...",
    "test:go": "go test -v ./...",
    "test:watch": "npm run test:watch --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
